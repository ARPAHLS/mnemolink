# ==============================================================================
# MnemoLink Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloud Frontier Model Provider API Keys
# ------------------------------------------------------------------------------
# Anthropic Claude (Claude 3.5 Sonnet, Claude 3.5 Haiku, Claude 4.5)
# Obtain key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google Gemini (Gemini 2.5 Flash, Gemini 2.0 Flash / Pro)
# Obtain key at: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI (GPT-4o, GPT-4o-mini, o1, o3-mini)
# Obtain key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 2. Local Open-Weight & Edge Inference (Zero Cloud Cost)
# ------------------------------------------------------------------------------
# Ollama Local Daemon (e.g. Llama 3.1 8B/70B, Qwen 2.5, Mistral Nemo)
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"

# ------------------------------------------------------------------------------
# 3. Optional High-Throughput & Specialized Providers
# ------------------------------------------------------------------------------
# Mistral AI (Mistral Large, Mistral Small, Codestral)
# Obtain key at: https://console.mistral.ai/
MISTRAL_API_KEY=

# Groq Cloud (Ultra-low latency Llama 3.1 & Qwen 2.5 inference)
# Obtain key at: https://console.groq.com/
GROQ_API_KEY=

# DeepSeek (DeepSeek-V3, DeepSeek-R1)
# Obtain key at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# ------------------------------------------------------------------------------
# 4. Catalog Resolution & Custom Paths
# ------------------------------------------------------------------------------
# Optional additional search paths for custom personas, memories, and lineages
# Format: semicolon-delimited list of directories
# MNEMOLINK_PATH="./custom_mnemonics;~/.mnemolink"
