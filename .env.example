# ==============================================================================
# MnemoLink Environment Configuration
# ==============================================================================

# Local Ollama Inference
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="llama3.2:1b"

# Cloud Model Provider API Keys
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional: LiteLLM Router Model (if testing via litellm extra)
# MNEMOLINK_MODEL="ollama/llama3.2:1b"
# MNEMOLINK_MODEL="anthropic/claude-3-5-sonnet-20241022"
# MNEMOLINK_MODEL="gemini/gemini-2.0-flash-exp"

# Optional: Additional search paths for custom personas, memories, and lineages
# MNEMOLINK_PATH="./custom_mnemonics;~/.mnemolink"
