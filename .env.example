# ==============================================================================
# MnemoLink Environment Configuration
# ==============================================================================

# Path Resolution
# Additional directory paths to search for custom personas, memories, and lineages
# Colon-separated on Unix, semicolon-separated on Windows
# MNEMOLINK_PATH="./custom_mnemonics;~/.mnemolink"

# Default Model Provider for Simulation & Lite Bench (via LiteLLM)
MNEMOLINK_MODEL="ollama/llama3.3"
# MNEMOLINK_MODEL="openai/gpt-4o"
# MNEMOLINK_MODEL="anthropic/claude-3-5-sonnet-20241022"
# MNEMOLINK_MODEL="gemini/gemini-2.0-flash-exp"

# Local Ollama Host
OLLAMA_HOST="http://localhost:11434"

# Cloud Model Provider API Keys (for live simulation & bench)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
